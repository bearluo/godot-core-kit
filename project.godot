; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-core-kit (dev)"
config/description="开发工程：托管并测试 godot-core-kit addon（纯 GDScript 通用基础库）。"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://addons/godot-core-kit/log.gd"
EventBus="*res://addons/godot-core-kit/event_bus.gd"
SceneManager="*res://addons/godot-core-kit/scene_manager.gd"
ObjectPool="*res://addons/godot-core-kit/object_pool.gd"
SaveManager="*res://addons/godot-core-kit/save_manager.gd"
CoreKit="*res://addons/godot-core-kit/core_kit.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dotnet]

project/assembly_name="godot-core-kit (dev)"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-core-kit/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

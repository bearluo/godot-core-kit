; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="晶核防线 (Crystal Line)"
config/description="example 手游塔防：验证 vision-first-slice + asset-bank；托管 godot-core-kit。"
run/main_scene="res://game/crystal_line/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CoreKit="*res://addons/godot-core-kit/core_kit.gd"

[dotnet]

project/assembly_name="godot-core-kit (dev)"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-core-kit/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

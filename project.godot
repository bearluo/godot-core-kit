; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-core-kit (dev)"
config/description="开发工程：托管并测试 godot-core-kit addon（纯 GDScript 通用基础库）。"
run/main_scene="res://examples/farm-sim/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CoreKit="*res://addons/godot-core-kit/core_kit.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dotnet]

project/assembly_name="godot-core-kit (dev)"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-core-kit/plugin.cfg", "res://addons/godot_ai/plugin.cfg")


schedule = [{
"after_hour": 0,
"area": &"town",
"x": 3,
"y": 5
}, {
"after_hour": 18,
"area": &"house",
"x": 5,
"y": 2
}]
dialogue = ["慢点走，孩子。", "地里的活儿别太累着。", "南瓜要秋天才种得活哦。", "记得常回来看看。"]
